# Leave blank for local development; Vite proxies /api to the auth service on localhost:8080.
# For deployments, set this to the externally reachable Auth-Svc base URL.
VITE_AUTH_API_BASE_URL=

# Auth-Svc local development: run from backend/Auth-Svc with
# mvn '-Dspring-boot.run.profiles=local' spring-boot:run
# The local profile persists to backend/Auth-Svc/data/roup-auth.mv.db.
# Optional backend setting: ROUP_MAX_RESALE_MULTIPLIER (default 1.2).
